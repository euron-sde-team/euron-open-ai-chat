# Generated by `make env` (scripts/gen-local-env.sh) with random values. Local only.
CHAT_JWT_SECRET=replace-with-output-of-make-env
CHAT_REFRESH_SECRET=replace-with-output-of-make-env
# 32 random bytes, base64 (openssl rand -base64 32): encrypts stored TOTP secrets.
CHAT_TOTP_ENCRYPTION_KEY=replace-with-output-of-make-env
# Every demo account (make demo) signs in with this password.
CHAT_DEMO_PASSWORD=replace-with-output-of-make-env
# SearXNG's server.secret_key (the compose searxng service).
CHAT_SEARXNG_SECRET=replace-with-output-of-make-env

# Real model providers (optional: `make demo` registers the "Stub" provider, which
# needs no key). Either one JSON object keyed by provider slug ...
# PROVIDER_KEYS={"openai":"sk-...","anthropic":"sk-ant-...","openrouter":"sk-or-..."}
# ... or the single-key shortcuts (PROVIDER_KEYS wins when both name a provider):
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...
# GROQ_API_KEY=gsk_...

# Web search (default: the bundled SearXNG). stub gives deterministic results from
# apps/stubs, as the tests use; tavily, exa and brave need their key.
# SEARCH_PROVIDER=stub
# SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=tvly-...
# EXA_API_KEY=...
# BRAVE_API_KEY=...

# Prompt moderation: none (default), stub or openai (needs an openai key).
# MODERATION_PROVIDER=stub

# Push notifications to the native apps (docs/guides/push.md): none (default), stub
# (messages are recorded at http://localhost:5129/fcm/messages) or fcm. For fcm, the
# Firebase service account key file on one line in single quotes (jq -c . key.json).
# PUSH_PROVIDER=stub
# PUSH_PROVIDER=fcm
# FCM_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"my-chat-app","client_email":"push@my-chat-app.iam.gserviceaccount.example.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'
# PUSH_PREVIEW=false

# Optional overrides (host ports and names)
# CHAT_PRODUCT_NAME=Euron Open AI Chat
# CHAT_LOG_LEVEL=info
# CHAT_WEB_PORT=3540
# CHAT_API_PORT=5036
# CHAT_PG_PORT=5502
# CHAT_REDIS_PORT=6439
# CHAT_MAILPIT_PORT=8056
# CHAT_SMTP_PORT=1056
# CHAT_FLOCI_PORT=4607
# CHAT_STUB_PORT=5129
# CHAT_SEARXNG_PORT=8089
